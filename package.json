{
  "name": "flowbite-svelte-mcp",
  "version": "0.3.2",
  "description": "MCP server for Flowbite-Svelte documentation (LLM)",
  "type": "module",
  "bin": {
    "flowbite-svelte-mcp": "./build/server.js"
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && tsx scripts/postbuild.ts",
    "start": "node build/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:registry": "tsx scripts/generateComponentRegistry.ts",
    "copy:llm": "tsx scripts/copyLlmData.ts",
    "ch": "npx changeset",
    "cv": "npx changeset version",
    "cp": "pnpm gen:registry && pnpm copy:llm && pnpm build && npx changeset publish"
  },
  "dependencies": {
    "@tmcp/adapter-zod": "^0.1.7",
    "@tmcp/transport-stdio": "^0.4.1",
    "tmcp": "^1.18.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.13",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.13"
  },
  "keywords": [
    "mcp",
    "mcp server",
    "flowbite-svelte"
  ],
  "author": {
    "name": "Shinichi Okada",
    "url": "https://codewithshin.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinokada/flowbite-svelte-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/shinokada/flowbite-svelte-mcp/issues"
  },
  "homepage": "https://flowbite-svelte.com/docs/mcp/overview"
}